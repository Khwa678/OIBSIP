        }

    ];


    /* =================================================
       APPLICATION STATE
    ================================================= */

    let selectedBase = null;

    let selectedSauce = null;

    let selectedCheese = null;

    let selectedVegetables = [];

    let currentUser = null;

    let authMode = "login";

    let currentOrder = null;


    /* =================================================
       LOCAL STORAGE INITIALIZATION
    ================================================= */

    if (!localStorage.getItem("pizzaUsers")) {

        localStorage.setItem(
            "pizzaUsers",
            JSON.stringify([])
        );

    }


    if (!localStorage.getItem("pizzaOrders")) {

        localStorage.setItem(
            "pizzaOrders",
            JSON.stringify([])
        );

    }


    /* =================================================
       NOTIFICATION
    ================================================= */

    function showNotification(message) {

        const notification =
            document.getElementById("notification");

        notification.textContent = message;

        notification.style.display = "block";

        setTimeout(function() {

            notification.style.display = "none";

        }, 3000);

    }


    /* =================================================
       RENDER PIZZA VARIETIES
    ================================================= */

    function renderPizzaVarieties() {

        const grid =
            document.getElementById("pizzaGrid");

        grid.innerHTML = "";

        pizzaVarieties.forEach(function(pizza) {

            const card =
                document.createElement("div");

            card.className = "pizza-card";

            card.innerHTML = `

                <div
                    class="pizza-image"
                    style="
                        background-image:
                        url('${pizza.image}')
                    ">
                </div>

                <div class="pizza-info">

                    <h3>
                        ${pizza.name}
                    </h3>

                    <p>
                        Delicious freshly prepared pizza.
                    </p>

                    <div class="price">
                        ₹${pizza.price}
                    </div>

                    <button
                        class="primary-btn"
                        data-pizza="${pizza.name}">

                        Order Now

                    </button>

                </div>
            `;

            grid.appendChild(card);

        });


        document
            .querySelectorAll("[data-pizza]")
            .forEach(function(button) {

                button.addEventListener(
                    "click",
                    function() {

                        document
                            .getElementById(
                                "builderSection"
                            )
                            .scrollIntoView({
                                behavior: "smooth"
                            });

                    }
                );

            });

    }


    /* =================================================
       RENDER OPTIONS
    ================================================= */

    function renderOptions() {

        renderSingleOptions(
            bases,
            "baseOptions",
            "base"
        );

        renderSingleOptions(
            sauces,
            "sauceOptions",
            "sauce"
        );

        renderSingleOptions(
            cheeses,
            "cheeseOptions",
            "cheese"
        );

        renderVegetables();

    }


    function renderSingleOptions(
        items,
        containerId,
        type
    ) {

        const container =
            document.getElementById(containerId);

        container.innerHTML = "";

        items.forEach(function(item) {

            const button =
                document.createElement("button");

            button.className = "option";

            button.innerHTML = `

                <strong>
                    ${item.name}
                </strong>

                <br>

                ₹${item.price}

            `;

            button.addEventListener(
                "click",
                function() {

                    if (type === "base") {

                        selectedBase = item;

                    }

                    if (type === "sauce") {

                        selectedSauce = item;

                    }

                    if (type === "cheese") {

                        selectedCheese = item;

                    }

                    container
                        .querySelectorAll(".option")
                        .forEach(function(btn) {

                            btn.classList.remove(
                                "selected"
                            );

                        });

                    button.classList.add("selected");

                    updateSummary();

                }
            );

            container.appendChild(button);

        });

    }


    /* =================================================
       VEGETABLES
    ================================================= */

    function renderVegetables() {

        const container =
            document.getElementById(
                "vegetableOptions"
            );

        container.innerHTML = "";

        vegetables.forEach(function(vegetable) {

            const label =
                document.createElement("label");

            label.className =
                "option vegetable-option";

            label.innerHTML = `

                <input
                    type="checkbox"
                    value="${vegetable.name}">

                <span>
                    ${vegetable.name}
                    (+₹${vegetable.price})
                </span>

            `;

            const checkbox =
                label.querySelector("input");

            checkbox.addEventListener(
                "change",
                function() {

                    if (checkbox.checked) {

                        selectedVegetables.push(
                            vegetable
                        );

                        label.classList.add(
                            "selected"
                        );

                    } else {

                        selectedVegetables =
                            selectedVegetables.filter(
                                function(item) {

                                    return item.name !==
                                        vegetable.name;

                                }
                            );

                        label.classList.remove(
                            "selected"
                        );

                    }

                    updateSummary();

                }
            );

            container.appendChild(label);

        });

    }


    /* =================================================
       CALCULATE TOTAL
    ================================================= */

    function calculateTotal() {

        let total = 0;


        if (selectedBase) {

            total += selectedBase.price;

        }


        if (selectedSauce) {

            total += selectedSauce.price;

        }


        if (selectedCheese) {

            total += selectedCheese.price;

        }


        selectedVegetables.forEach(
            function(vegetable) {

                total += vegetable.price;

            }
        );


        return total;

    }


    /* =================================================
       UPDATE SUMMARY
    ================================================= */

    function updateSummary() {

        const summary =
            document.getElementById(
                "summaryContent"
            );

        let html = "";


        if (selectedBase) {

            html += `

                <div class="summary-row">

                    <span>Base</span>

                    <span>
                        ${selectedBase.name}
                    </span>

                </div>

            `;

        }


        if (selectedSauce) {

            html += `

                <div class="summary-row">

                    <span>Sauce</span>

                    <span>
                        ${selectedSauce.name}
                    </span>

                </div>

            `;

        }


        if (selectedCheese) {

            html += `

                <div class="summary-row">

                    <span>Cheese</span>

                    <span>
                        ${selectedCheese.name}
                    </span>

                </div>

            `;

        }


        if (selectedVegetables.length > 0) {

            html += `

                <div class="summary-row">

                    <span>Vegetables</span>

                    <span>
                        ${
                            selectedVegetables
                                .map(function(v) {
                                    return v.name;
                                })
                                .join(", ")
                        }
                    </span>

                </div>

            `;

        }


        if (html === "") {

            html = `
                <p>
                    Select your pizza ingredients.
                </p>
            `;

        }


        summary.innerHTML = html;


        document.getElementById(
            "total"
        ).textContent =
            "Total: ₹" + calculateTotal();

    }


    /* =================================================
       AUTH MODAL
    ================================================= */

    function openAuth(mode) {

        authMode = mode;

        document
            .getElementById("authModal")
            .classList.add("active");


        document
            .getElementById("authTitle")
            .textContent =
                mode === "login"
                ? "Login"
                : "Create Account";


        document
            .getElementById("authSubmit")
            .textContent =
                mode === "login"
                ? "Login"
                : "Register";


        document
            .getElementById("nameInput")
            .style.display =
                mode === "register"
                ? "block"
                : "none";

    }


    document
        .getElementById("loginBtn")
        .addEventListener(
            "click",
            function() {

                openAuth("login");

            }
        );


    document
        .getElementById("registerBtn")
        .addEventListener(
            "click",
            function() {

                openAuth("register");

            }
        );


    document
        .getElementById("closeModal")
        .addEventListener(
            "click",
            function() {

                document
                    .getElementById("authModal")
                    .classList.remove(
                        "active"
                    );

            }
        );


    /* =================================================
       AUTH SUBMIT
    ================================================= */

    document
        .getElementById("authSubmit")
        .addEventListener(
            "click",
            function() {

                const email =
                    document
                        .getElementById(
                            "emailInput"
                        )
                        .value
                        .trim();

                const password =
                    document
                        .getElementById(
                            "passwordInput"
                        )
                        .value;

                const name =
                    document
                        .getElementById(
                            "nameInput"
                        )
                        .value
                        .trim();


                if (!email || !password) {

                    showNotification(
                        "Please fill all required fields."
                    );

                    return;

                }


                let users =
                    JSON.parse(
                        localStorage.getItem(
                            "pizzaUsers"
                        )
                    );


                /* REGISTER */

                if (authMode === "register") {

                    if (!name) {

                        showNotification(
                            "Please enter your name."
                        );

                        return;

                    }


                    const existingUser =
                        users.find(
                            function(user) {

                                return user.email ===
                                    email;

                            }
                        );


                    if (existingUser) {

                        showNotification(
                            "Email already registered."
                        );

                        return;

                    }


                    users.push({

                        name: name,

                        email: email,

                        password: password,

                        verified: true

                    });


                    localStorage.setItem(
                        "pizzaUsers",
                        JSON.stringify(users)
                    );


                    showNotification(
                        "Registration successful! Email verified."
                    );


                    document
                        .getElementById(
                            "authModal"
                        )
                        .classList.remove(
                            "active"
                        );

                    return;

                }


                /* LOGIN */

                const user =
                    users.find(
                        function(user) {

                            return user.email === email &&
                                user.password === password;

                        }
                    );


                if (!user) {

                    showNotification(
                        "Invalid email or password."
                    );

                    return;

                }


                currentUser = user;


                localStorage.setItem(
                    "currentPizzaUser",
                    JSON.stringify(user)
                );


                document
                    .getElementById(
                        "authModal"
                    )
                    .classList.remove(
                        "active"
                    );


                updateNavbar();


                showNotification(
                    "Login successful!"
                );

            }
        );


    /* =================================================
       LOGOUT
    ================================================= */

    document
        .getElementById("logoutBtn")
        .addEventListener(
            "click",
            function() {

                currentUser = null;

                localStorage.removeItem(
                    "currentPizzaUser"
                );

                updateNavbar();

                showNotification(
                    "Logged out successfully."
                );

            }
        );


    function updateNavbar() {

        document
            .getElementById("loginBtn")
            .style.display =
                currentUser ? "none" : "block";


        document
            .getElementById("registerBtn")
            .style.display =
                currentUser ? "none" : "block";


        document
            .getElementById("logoutBtn")
            .style.display =
                currentUser ? "block" : "none";

    }


    /* =================================================
       FORGOT PASSWORD
    ================================================= */

    document
        .getElementById("forgotBtn")
        .addEventListener(
            "click",
            function() {

                const email =
                    prompt(
                        "Enter your registered email:"
                    );


                if (!email) {

                    return;

                }


                const users =
                    JSON.parse(
                        localStorage.getItem(
                            "pizzaUsers"
                        )
                    );


                const user =
                    users.find(
                        function(u) {

                            return u.email === email;

                        }
                    );


                if (!user) {

                    showNotification(
                        "Email not found."
                    );

                    return;

                }


                showNotification(
                    "Password reset link sent to your email (demo)."
                );

            }
        );


    /* =================================================
       PAYMENT
    ================================================= */

    document
        .getElementById("orderBtn")
        .addEventListener(
            "click",
            function() {

                if (!currentUser) {

                    showNotification(
                        "Please login before ordering."
                    );

                    openAuth("login");

                    return;

                }


                if (
                    !selectedBase ||
                    !selectedSauce ||
                    !selectedCheese
                ) {

                    showNotification(
                        "Please complete all pizza builder steps."
                    );

                    return;

                }


                const total =
                    calculateTotal();


                document
                    .getElementById(
                        "paymentAmount"
                    )
                    .textContent =
                        "Amount: ₹" + total;


                document
                    .getElementById(
                        "paymentModal"
                    )
                    .classList.add(
                        "active"
                    );

            }
        );


    document
        .getElementById("paymentCancel")
        .addEventListener(
            "click",
            function() {

                document
                    .getElementById(
                        "paymentModal"
                    )
                    .classList.remove(
                        "active"
                    );

            }
        );


    /* =================================================
       PAYMENT SUCCESS
    ================================================= */

    document
        .getElementById("paymentSuccess")
        .addEventListener(
            "click",
            function() {

                const order = {

                    id:
                        "PIZZA-" +
                        Date.now(),

                    customer:
                        currentUser.email,

                    pizza: {

                        base: selectedBase,

                        sauce: selectedSauce,

                        cheese: selectedCheese,

                        vegetables:
                            selectedVegetables

                    },

                    amount:
                        calculateTotal(),

                    status: 1,

                    date:
                        new Date()
                            .toLocaleString()

                };


                let orders =
                    JSON.parse(
                        localStorage.getItem(
                            "pizzaOrders"
                        )
                    );


                orders.push(order);


                localStorage.setItem(
                    "pizzaOrders",
                    JSON.stringify(orders)
                );


                currentOrder = order;


                document
                    .getElementById(
                        "paymentModal"
                    )
                    .classList.remove(
                        "active"
                    );


                showNotification(
                    "Payment successful! Order confirmed."
                );


                showTracking(order);


                simulateOrderProgress();

            }
        );


    /* =================================================
       ORDER TRACKING
    ================================================= */

    function showTracking(order) {

        document
            .getElementById(
                "trackingSection"
            )
            .style.display = "block";


        document
            .getElementById(
                "orderId"
            )
            .textContent =
                "Order ID: " + order.id;


        document
            .getElementById(
                "trackingSection"
            )
            .scrollIntoView({
                behavior: "smooth"
            });

    }


    function simulateOrderProgress() {

        setTimeout(
            function() {

                updateOrderStatus(2);

            },
            5000
        );


        setTimeout(
            function() {

                updateOrderStatus(3);

            },
            10000
        );


        setTimeout(
            function() {

                updateOrderStatus(4);

            },
            15000
        );

    }


    function updateOrderStatus(status) {

        currentOrder.status = status;


        for (
            let i = 1;
            i <= 4;
            i++
        ) {

            const step =
                document.getElementById(
                    "step" + i
                );


            if (i <= status) {

                step.classList.add(
                    "active"
                );

            } else {

                step.classList.remove(
                    "active"
                );

            }

        }


        if (status === 4) {

            showNotification(
                "Your pizza has been delivered! 🍕"
            );

        }

    }


    /* =================================================
       ADMIN INVENTORY
    ================================================= */

    const inventoryData = [

        {
            name: "Classic Base",
            stock: 25
        },

        {
            name: "Tomato Sauce",
            stock: 18
        },

        {
            name: "Mozzarella",
            stock: 12
        },

        {
            name: "Onion",
            stock: 20
        },

        {
            name: "Capsicum",
            stock: 8
        },

        {
            name: "Mushroom",
            stock: 5
        }

    ];


    function renderInventory() {

        const container =
            document.getElementById(
                "inventory"
            );

        container.innerHTML = "";


        inventoryData.forEach(
            function(item) {

                const card =
                    document.createElement(
                        "div"
                    );

                card.className =
                    "stock-card";


                const lowStock =
                    item.stock <= 5;


                card.innerHTML = `

                    <h3>
                        ${item.name}
                    </h3>

                    <p>
                        Stock:
                        <strong>
                            ${item.stock}
                        </strong>
                    </p>

                    ${
                        lowStock
                        ?
                        `
                        <p class="low-stock">
                            ⚠ Low Stock
                        </p>
                        `
                        :
                        `
                        <p>
                            Available
                        </p>
                        `
                    }

                `;


                container.appendChild(card);


                if (lowStock) {

                    console.log(
                        "Low stock notification:",
                        item.name
                    );

                }

            }
        );

    }


    /* =================================================
       START BUTTON
    ================================================= */

    document
        .getElementById("startBtn")
        .addEventListener(
            "click",
            function() {

                document
                    .getElementById(
                        "builderSection"
                    )
                    .scrollIntoView({
                        behavior: "smooth"
                    });

            }
        );


    /* =================================================
       INITIALIZE
    ================================================= */

    renderPizzaVarieties();

    renderOptions();

    renderInventory();

    updateSummary();


    /* Restore login */

    const savedUser =
        localStorage.getItem(
            "currentPizzaUser"
        );


    if (savedUser) {

        currentUser =
            JSON.parse(savedUser);

        updateNavbar();

    }

</script>

</body>

</html>
